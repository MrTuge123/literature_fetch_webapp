# Copy to .env.local (git-ignored), or make it with:
#   python scripts/web_env.py --profile litfetch
# Values are the LitFetchApi stack outputs. They are not secrets (the browser sees them),
# but they stay out of git anyway.
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-2.amazonaws.com
VITE_USER_POOL_ID=us-east-2_XXXXXXXXX
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
